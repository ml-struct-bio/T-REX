include README.md
include LICENSE
include CITATION.cff
include CONTRIBUTING.md
include .env.example
prune internal
prune audit
prune reviews
include benchmarks/__init__.py
recursive-include benchmarks/llm_validation *.md *.py
recursive-include config *.json *.txt
recursive-include docs *.md *.py *.txt
recursive-include examples *
prune external
include external/README.md
recursive-include external/patches *.patch
recursive-include scripts *.py *.sh
recursive-include slurm *.slurm
global-exclude *.py[cod]
global-exclude __pycache__
recursive-include trex/tests *.py
