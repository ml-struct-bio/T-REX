# Copy to .env in the repository root after running asset configure.
# Paths must be visible from compute nodes. See docs/installation.md.
TREX_REPO_ROOT="${TREX_REPO_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"
if [[ ! -r "${TREX_REPO_ROOT}/.env.assets" ]]; then
  echo "Missing .env.assets: complete docs/assets.md first." >&2
  return 1
fi
source "${TREX_REPO_ROOT}/.env.assets"

# Compatibility defaults for scripts/submit.sh. The recommended `trex submit
# campaign.yaml` workflow overrides these values from the campaign YAML.
# GPU count includes one GPU reserved for the local LLM.
TARGET=cd45
TREX_NUM_GPUS=4
TREX_MAX_WALL_H=48.0
TREX_ARCHIVE_BASE="${TREX_REPO_ROOT}/runs"

# Registered targets resolve their inputs from TARGET and .env.assets.
# For a custom target, uncomment and set both paths:
# TREX_TARGET_CONFIG=/absolute/path/to/my_target.json
# TREX_TARGET_PDB=/absolute/path/to/my_target.pdb

# Environment paths. Change these if you installed elsewhere.
TREX_VLLM_VENV="${TREX_REPO_ROOT}/.venv-serving"
TREX_CONTROLLER_PYTHON="${TREX_VLLM_VENV}/bin/python"
TREX_COMPLEXA_PYTHON="${TREX_COMPLEXA_REPO}/.venv/bin/python"
TREX_BINDCRAFT_ENV="${TREX_BINDCRAFT_REPO:-${TREX_REPO_ROOT}/external/BindCraft}/.venv"
TREX_BOLTZGEN_REPO="${TREX_REPO_ROOT}/external/BoltzGen"
TREX_BOLTZGEN_BIN="${TREX_BOLTZGEN_REPO}/.venv/bin/boltzgen"
TREX_FOLDSEEK_BIN="${TREX_COMPLEXA_REPO}/.venv/bin/foldseek"
TREX_MMSEQS_BIN="${TREX_COMPLEXA_REPO}/.venv/bin/mmseqs"

# Optional settings. The launcher derives worker indices and the Slurm time
# request from the campaign settings above, adding startup/shutdown time.
TREX_GPU_TYPE=h100
TREX_SERVED_MODEL_NAME=Qwen/Qwen3.6-27B-FP8
TREX_ENABLED_FAMILIES=bindcraft,boltzgen,complexa_beam,complexa_best_of_n,complexa_fk_steering,complexa_mcts,proteinmpnn_redesign,structure_refilter
TREX_FOLDSEEK_SU_TM_SCORE=0.60
TREX_FOLDSEEK_COLLAPSE_TM_SCORE=0.60
TREX_SEED=0
TREX_VERIFY_BACKEND_REVISIONS=1
# Resume: set TREX_RESUME_ARCHIVE to the exact existing archive. See docs/slurm.md.
