# Repository and runtime output
TREX_REPO_ROOT=/path/to/T-ReX
TREX_ARCHIVE_BASE=/path/to/trex-runs
TREX_TARGET_ASSET_ROOT=/path/to/Proteina-Complexa/assets/target_data

# External scientific backends
TREX_COMPLEXA_REPO=/path/to/Proteina-Complexa
TREX_LEGACY_COMPLEXA_REPO=/path/to/T-ReX/external/Proteina-Complexa-community
TREX_COMPLEXA_PYTHON=/path/to/proteina-complexa/.venv/bin/python
TREX_BINDCRAFT_REPO=/path/to/BindCraft
TREX_BINDCRAFT_ENV=/path/to/BindCraft/environment
TREX_BOLTZGEN_REPO=/path/to/boltzgen
TREX_BOLTZGEN_BIN=/path/to/boltzgen/bin/boltzgen
TREX_BOLTZGEN_CACHE=/path/to/boltzgen/checkpoints

# Structure and sequence clustering executables (recommended: exact paths)
TREX_FOLDSEEK_BIN=/path/to/foldseek
TREX_MMSEQS_BIN=/path/to/mmseqs

# Local OpenAI-compatible LLM server
TREX_VLLM_VENV=/path/to/vllm/environment
TREX_CONTROLLER_PYTHON=/path/to/vllm/environment/bin/python
# Optional dev environment used only by publication_preflight.slurm.
TREX_TEST_PYTHON=/path/to/trex-dev/environment/bin/python
TREX_QWEN_MODEL_PATH=/path/to/Qwen3.6-27B-FP8
TREX_MODEL_MANIFEST=/path/to/T-ReX/config/trex/qwen3_6_27b_fp8_model_manifest.json
TREX_SERVED_MODEL_NAME=Qwen/Qwen3.6-27B-FP8
TREX_VLLM_PORT=8000

# Optional provider keys when using a hosted model instead of local vLLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Publication campaign defaults (GPU 0 LLM, GPUs 1-3 workers)
TREX_ENABLED_FAMILIES=bindcraft,boltzgen,complexa_beam,complexa_best_of_n,complexa_fk_steering,complexa_mcts,proteinmpnn_redesign,structure_refilter
TREX_WORKER_GPUS=1,2,3
TREX_REQUIRE_THREE_WORKERS=1
# Raw resource-audit GPU count. For scaled Slurm runs, set this to the total
# allocated GPU count or remove it so the launcher derives local LLM GPU + workers.
TREX_CHARGED_GPUS=4
# Cumulative controller hours; Slurm reserves 49 hours including overhead.
TREX_MAX_WALL_H=48.0
TREX_FOLDSEEK_SU_TM_SCORE=0.60
TREX_FOLDSEEK_COLLAPSE_TM_SCORE=0.60
TREX_SEED=0
TREX_VERIFY_BACKEND_REVISIONS=1

# Optional operator-installed backend adapters (module:attribute, comma-separated).
# Prefer the `trex.backends` Python entry-point group for distributable plugins.
TREX_BACKEND_PLUGINS=
